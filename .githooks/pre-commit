#!/usr/bin/env bash
# Fast CI-parity checks before each commit. Mirrors the fast half of
# scripts/check.sh (ruff lint + format, mypy, import-linter); the slow pytest
# suite runs in the pre-push hook instead, so committing stays quick.
#
# Every analyzer runs against the COMMIT's content, not the worktree. Fully
# staged Python files are auto-formatted and re-staged first; then unstaged
# tracked changes are set aside (saved as a patch, worktree reset to the index)
# so Ruff, mypy, and import-linter see exactly the staged snapshot. Without this
# a partially staged file could pass here on its fixed worktree while the broken
# staged content is the one committed and later fails CI.
#
# The patch is re-applied on any exit. A patch applies onto the same base it was
# diffed from (checks are read-only, so the base is unchanged) — unlike
# `git stash pop`, whose 3-way merge spuriously conflicts on newly added files.
# If a re-apply ever fails, the changes are preserved in the patch file
# (recoverable), never lost.
#
# Bypass with `git commit --no-verify`. Enable with:
#   git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

VENV_DIR="${ORCA_AUTO_VENV:-$ROOT/.venv}"
PY="$VENV_DIR/bin/python"
if [[ ! -x "$PY" ]]; then
  echo "[pre-commit] .venv not found at $VENV_DIR; run scripts/check.sh once to create it." >&2
  exit 1
fi

mapfile -t py_files < <(git diff --cached --name-only --diff-filter=ACM -- '*.py')

# Auto-format only fully-staged Python files: their worktree matches the index,
# so re-staging cannot pull in unrelated unstaged hunks. Do this BEFORE setting
# the worktree aside. `git diff --quiet -- f` is 0 iff f has no unstaged changes.
for f in "${py_files[@]:-}"; do
  [[ -n "$f" ]] || continue
  if git diff --quiet -- "$f" && ! "$PY" -m ruff format --check -- "$f" >/dev/null 2>&1; then
    echo "[pre-commit] ruff format: reformatting and re-staging $f"
    "$PY" -m ruff format -- "$f"
    git add -- "$f"
  fi
done

# Set unstaged tracked changes aside so the analyzers see the staged snapshot.
patch="$(git rev-parse --git-dir)/pre-commit-unstaged.patch"
have_patch=0
restore() {
  if ((have_patch)); then
    if git apply --whitespace=nowarn "$patch" 2>/dev/null; then
      rm -f "$patch"
    else
      echo "[pre-commit] WARNING: could not re-apply your unstaged changes; they are saved at $patch (recover with: git apply '$patch')." >&2
    fi
  fi
}
trap restore EXIT

if ! git diff --quiet; then
  git diff --binary --no-color >"$patch"
  have_patch=1
  git checkout --quiet -- .
fi

if ((${#py_files[@]})); then
  echo "[pre-commit] ruff check"
  "$PY" -m ruff check -- "${py_files[@]}"
  echo "[pre-commit] ruff format --check"
  "$PY" -m ruff format --check -- "${py_files[@]}"
fi

echo "[pre-commit] mypy"
"$PY" -m mypy

echo "[pre-commit] import-linter"
"$VENV_DIR/bin/lint-imports"

echo "[pre-commit] OK"
