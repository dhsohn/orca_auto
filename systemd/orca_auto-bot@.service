[Unit]
Description=orca_auto provider-neutral messenger bot for %i
After=network-online.target
Wants=network-online.target
PartOf=orca_auto-runtime@%i.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/orca_auto
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ORCA_AUTO_CONFIG=/home/%i/orca_auto/config/orca_auto.yaml
ExecStart=/home/%i/orca_auto/.venv/bin/python -m orca_auto.flow.bot.runner
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# ORCA_AUTO_READ_WRITE_PATHS
UMask=0077
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
