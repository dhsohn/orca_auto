# Shared orca_auto config example.
#
# Search order:
# 1. $ORCA_AUTO_CONFIG
# 2. <project_root>/config/orca_auto.yaml
# 3. ~/orca_auto/config/orca_auto.yaml
#
# Use Linux paths only. Windows-style paths such as C:\... or /mnt/c/... are
# not supported.
#
# Directory layout: everything lives under a single runs root
# (orca.runtime.allowed_root). Standalone ORCA jobs and workflow workspaces
# sit side by side in it, and the shared admission directory defaults to a
# hidden ".admission" inside it:
#   <runs root>/<your_job_dir>/          standalone ORCA runs (names are yours)
#   <runs root>/<workflow_id>/           workflow workspaces
#   <runs root>/.admission/              shared admission slots (automatic)

resources:
  # Default per-task resource requests. ORCA uses these as defaults for missing
  # input directives; workflow-managed xTB/CREST use them for launch flags/env
  # and memory limits unless a task or manifest overrides them.
  max_cores_per_task: 8
  max_memory_gb_per_task: 32

scheduler:
  # Shared total active-run cap across ORCA, internal xTB workflow stages, and
  # internal CREST workflow stages. All engine workers use this shared
  # admission lifecycle.
  max_active_simulations: 4
  # Shared admission directory for machine-wide slot coordination.
  # If omitted, orca_auto defaults to "<runs root>/.admission".
  # admission_root: /home/user/runs/.admission

workflow:
  # Base directory for workflow workspaces. If omitted, workflows live in the
  # runs root (orca.runtime.allowed_root) next to standalone ORCA jobs.
  # root: /home/user/runs
  paths:
    # Executables used by workflow-managed internal stages. If set, each value
    # must be an absolute Linux path to an existing executable file. Leave blank
    # only when you intentionally want PATH lookup at runtime.
    xtb_executable: /home/user/bin/xtb-dist/bin/xtb
    crest_executable: /home/user/bin/crest/crest
  # Internal xTB/CREST runtime roots are derived automatically and are not set
  # directly in config. Each workflow keeps its own queue.json,
  # job_locations.json, and job dirs under one directory per engine stage,
  # e.g. <runs root>/<workflow_id>/01_crest, .../02_xtb, .../03_orca.

telegram:
  # Leave blank to disable the unified Telegram bot and shared Telegram
  # notifications that use this config.
  bot_token: ""
  chat_id: ""
  # Each Telegram API call waits up to this many seconds before retry/fail.
  timeout_seconds: 5.0
  # Retry transient Telegram send failures this many times total.
  max_attempts: 2
  # Pause between retry attempts for transient Telegram failures.
  retry_backoff_seconds: 0.5

orca:
  runtime:
    # The single runs root. ORCA jobs execute here and completed runs stay
    # here (keeping their submitted directory names); workflow workspaces and
    # the default .admission directory live here too.
    allowed_root: /home/user/runs
    # Retry count after the initial attempt.
    # Example: 2 means "1 initial run + up to 2 retries" = 3 total attempts.
    default_max_retries: 2
  paths:
    # Linux path to the ORCA executable.
    orca_executable: /home/user/opt/orca/orca
