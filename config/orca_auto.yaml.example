# Shared orca_auto config example.
#
# Search order:
# 1. $ORCA_AUTO_CONFIG
# 2. <project_root>/config/orca_auto.yaml
# 3. ~/orca_auto/config/orca_auto.yaml
#
# Use Linux paths only. Windows-style paths such as C:\... or /mnt/c/... are
# not supported.
# Only the documented keys below are accepted. Unknown, misspelled, and removed
# keys fail configuration loading instead of being ignored or defaulted.

# The single runs root. Everything lives under this directory: standalone ORCA
# jobs and workflow workspaces sit side by side in it, and the shared
# admission directory defaults to a hidden ".admission" inside it:
#   <runs_root>/<your_job_dir>/          standalone ORCA runs
#   <runs_root>/<workflow_id>/           workflow workspaces
#   <runs_root>/.admission/              shared admission slots (automatic)
runs_root: /home/user/runs

resources:
  # Default per-task resource requests. ORCA uses these as defaults for missing
  # input directives; workflow-managed xTB/CREST use them
  # unless a validated task or manifest requests a value at or below them.
  max_cores_per_task: 8
  max_memory_gb_per_task: 32

scheduler:
  # Shared total active-run cap across ORCA, internal xTB workflow stages, and
  # internal CREST workflow stages. All engine workers use this shared admission
  # lifecycle.
  max_active_simulations: 4
  # Shared admission directory for machine-wide slot coordination.
  # If omitted, orca_auto defaults to "<runs_root>/.admission".
  # admission_root: /home/user/runs/.admission

workflow:
  paths:
    # xTB is used by workflow-managed internal stages; CREST is workflow-only.
    # If set, each value must be an absolute Linux path to an existing
    # executable file. Leave blank only when you intentionally want PATH lookup
    # during submission; the resolved executable path and content identity are
    # then bound to that queue generation.
    xtb_executable: /home/user/bin/xtb-dist/bin/xtb
    crest_executable: /home/user/bin/crest/crest
  # Internal xTB/CREST runtime roots are derived automatically and are not set
  # directly in config. Each workflow keeps its own xTB/CREST queue.json,
  # job_locations.json, and job dirs under one directory per engine stage,
  # e.g. <runs_root>/<workflow_id>/01_crest and .../02_xtb. Workflow ORCA
  # stage job dirs live under .../03_orca, but their queue rows and
  # job-location records stay in the shared ORCA queue at <runs_root>.
  # Fixed admission guardrails are not config knobs: YAML job manifests are at
  # most 1 MiB/32 aliases/10,000 nodes/64 levels with cyclic/recursive graphs
  # rejected; geometries are capped at 10,000 atoms locally and 1,000 for
  # xTB/ORCA Hessian-producing jobs.

messenger:
  # Selects where outbound run/queue notifications are delivered.
  # `discord` is the only supported provider. Delivery is one-way: orca_auto
  # sends notifications and never accepts inbound commands.
  provider: discord  # discord
  # Tokens and channel IDs are strings. Explicit null/bool/wrong collection
  # shapes are rejected; blank strings intentionally disable notifications.
  discord:
    # Use a separate Discord application/bot for orca_auto. The bot token plus
    # the default channel deliver outbound notifications. Leave either blank to
    # disable Discord notifications.
    bot_token: ""
    default_channel_id: ""
    # Each Discord API call waits up to this many seconds before retry/fail.
    timeout_seconds: 5.0
    # Retry transient Discord send failures this many times total.
    max_attempts: 2
    # Pause between retry attempts for transient Discord failures.
    retry_backoff_seconds: 0.5

orca:
  runtime:
    # Shared RAM-backed working root for ORCA and workflow-managed xTB/CREST.
    # Exactly one private attempt runs below /dev/shm. ORCA transactionally
    # publishes surviving non-*.tmp artifacts; workflow xTB/CREST publish their
    # canonical result/evidence allowlists and omit engine work trees and
    # transient files.
    # Host/WSL loss still loses all unpublished scratch progress. An unresolved
    # workspace blocks new launches until it is inspected or tmpfs is reset.
    # scratch_root: /dev/shm/orca_auto
    # Refuse a new attempt unless this much tmpfs space remains in addition to
    # its bound input snapshot. Launch also requires current MemAvailable to
    # cover the per-task memory cap, all remaining tmpfs space, and this reserve.
    # These are admission guards, not a per-job quota or a no-swap guarantee.
    # scratch_min_free_gb: 8
  paths:
    # Linux path to the ORCA executable.
    orca_executable: /home/user/opt/orca/orca
