# Shared orca_auto config example.
#
# Search order:
# 1. $ORCA_AUTO_CONFIG
# 2. <project_root>/config/orca_auto.yaml
# 3. ~/orca_auto/config/orca_auto.yaml
#
# Use Linux paths only. Windows-style paths such as C:\... or /mnt/c/... are
# not supported.

# The single runs root. Everything lives under this directory: standalone ORCA
# jobs and workflow workspaces sit side by side in it, and the shared admission
# directory defaults to a hidden ".admission" inside it:
#   <runs_root>/<your_job_dir>/          standalone ORCA runs (names are yours)
#   <runs_root>/<workflow_id>/           workflow workspaces
#   <runs_root>/.admission/              shared admission slots (automatic)
runs_root: /home/user/runs

resources:
  # Default per-task resource requests. ORCA uses these as defaults for missing
  # input directives; workflow-managed xTB/CREST use them for launch flags/env
  # and memory limits unless a task or manifest overrides them.
  max_cores_per_task: 8
  max_memory_gb_per_task: 32

scheduler:
  # Shared total active-run cap across ORCA, internal xTB workflow stages, and
  # internal CREST workflow stages. All engine workers use this shared
  # admission lifecycle.
  max_active_simulations: 4
  # Shared admission directory for machine-wide slot coordination.
  # If omitted, orca_auto defaults to "<runs_root>/.admission".
  # admission_root: /home/user/runs/.admission

workflow:
  paths:
    # Executables used by workflow-managed internal stages. If set, each value
    # must be an absolute Linux path to an existing executable file. Leave blank
    # only when you intentionally want PATH lookup during submission; the
    # resolved executable path and content identity are then bound to that queue generation.
    xtb_executable: /home/user/bin/xtb-dist/bin/xtb
    crest_executable: /home/user/bin/crest/crest
  # Internal xTB/CREST runtime roots are derived automatically and are not set
  # directly in config. Each workflow keeps its own queue.json,
  # job_locations.json, and job dirs under one directory per engine stage,
  # e.g. <runs_root>/<workflow_id>/01_crest, .../02_xtb, .../03_orca.
  # Fixed admission guardrails are not config knobs: YAML job manifests are at
  # most 1 MiB/32 aliases/10,000 nodes/64 levels with cyclic/recursive graphs
  # rejected; geometries are capped at 10,000 atoms locally, 1,000 for xTB/ORCA
  # Hessian-producing jobs, and 200 for remote uploads.

messenger:
  # Selects where outbound run/queue/monitor notifications are delivered.
  # `telegram` (default) and `discord` both support outbound notifications and
  # interactive /list, /cancel, and /help commands through the same bot app.
  provider: telegram  # telegram | discord
  telegram:
    # Telegram credentials. Used by the interactive bot and, when
    # `provider` is `telegram`, by outbound notifications. Leave blank to
    # disable the Telegram bot and Telegram notifications.
    bot_token: ""
    chat_id: ""
    # Required for group chats; private chats are implicitly single-user.
    allowed_user_ids: []
    # Each Telegram API call waits up to this many seconds before retry/fail.
    timeout_seconds: 5.0
    # Retry transient Telegram send failures this many times total.
    max_attempts: 2
    # Pause between retry attempts for transient Telegram failures.
    retry_backoff_seconds: 0.5
  discord:
    # Use a separate Discord application/bot for orca_auto. The bot token plus
    # default channel sends notifications; channel_ids authorizes ordinary
    # inbound commands. The default-only channel still accepts this bot's
    # component-button interactions.
    bot_token: ""
    channel_ids: []
    default_channel_id: ""
    # Required operator allowlist for interactive controls. Keeping this empty
    # leaves Discord notifications enabled but fails the gateway closed.
    allowed_user_ids: []
    timeout_seconds: 5.0
    max_attempts: 2
    retry_backoff_seconds: 0.5
    # Optional: accept a compressed run-dir (.zip/.tar.gz) from an operator with
    # the `!run` command and submit it to the queue. DISABLED by default: it
    # turns the bot into an execution ingress, so only enable it for a trusted,
    # allowlisted operator. The archive is safe-extracted under `runs_root`
    # (path-traversal, symlink, and decompression-bomb guards always apply), and
    # queueing waits for an explicit Confirm button. Results are not sent back;
    # view them over your own remote access.
    uploads:
      enabled: false
      # Reserve this declared size before download, then enforce the same limit
      # again against the bytes actually streamed from Discord's trusted CDN.
      max_archive_bytes: 26214400        # 25 MiB
      # Decompression-bomb guards: total expanded size and per-file size.
      max_total_uncompressed_bytes: 209715200  # 200 MiB
      max_file_bytes: 104857600          # 100 MiB
      max_entries: 4000
      # Durable staging quota and lifecycle. A reservation is taken before the
      # Discord CDN download starts, bounding concurrent count and bytes.
      max_staged_bytes: 536870912        # 512 MiB across pending uploads
      max_staged_uploads: 32
      max_pending_per_actor: 4
      max_concurrent_downloads: 4
      staging_ttl_seconds: 3600          # unconfirmed/failed upload retention
      committed_retention_seconds: 86400 # idempotency receipt retention
      # Only these file types are written to disk. Extend for unusual run-dir
      # contents; a leading dot is optional and matching is case-insensitive.
      allowed_extensions: [inp, xyz, yaml, yml, json, txt, gbw, hess, pc]

orca:
  runtime:
    # Retry count after the initial attempt.
    # Example: 2 means "1 initial run + up to 2 retries" = 3 total attempts.
    default_max_retries: 2
  paths:
    # Linux path to the ORCA executable.
    orca_executable: /home/user/opt/orca/orca
