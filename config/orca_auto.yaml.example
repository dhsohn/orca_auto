# Linux/WSL configuration. Unknown keys and malformed values are rejected.
# Discovery: explicit --config, ORCA_AUTO_CONFIG, then ~/orca_auto/config/orca_auto.yaml.
# A source checkout is not probed. Keep real tokens out of source control.
runs_root: /home/user/orca_runs

resources:
  # Defaults for missing ORCA input directives; explicit %pal/%maxcore stay authoritative.
  max_cores_per_task: 8
  max_memory_gb_per_task: 32

scheduler:
  max_active_simulations: 4
  # Defaults to <runs_root>/.admission. Share it to coordinate workers on one host.
  # admission_root: /home/user/orca_runs/.admission

orca:
  paths:
    orca_executable: /home/user/opt/orca/orca
  # Optional private tmpfs scratch. Unpublished progress is lost on host/WSL shutdown.
  # runtime:
  #   scratch_root: /dev/shm/orca_auto
  #   scratch_min_free_gb: 8
  # A launch refused for memory capacity stays pending. Unresolved scratch ownership
  # blocks launches until inspected. This is an admission guard, not a memory quota.

messenger:
  provider: discord
  discord:
    # Blank strings disable outbound notifications. No inbound commands are accepted.
    bot_token: ""
    default_channel_id: ""
    timeout_seconds: 5.0
    max_attempts: 2
    retry_backoff_seconds: 0.5
